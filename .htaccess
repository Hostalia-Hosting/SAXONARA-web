RewriteEngine On
ErrorDocument 404 /404.php

# ==========================================================
# MIGRACIÓ SEO: DE ROOT A CARPETA /ES/
# ==========================================================
Redirect 301 /about.php https://www.saxonara.com/es/about.php
Redirect 301 /jazzband.php https://www.saxonara.com/es/jazzband.php
Redirect 301 /repertoire.php https://www.saxonara.com/es/repertoire.php
Redirect 301 /sax-costabrava.php https://www.saxonara.com/es/saxo-costabrava.php
Redirect 301 /saxofonista-bodas.php https://www.saxonara.com/es/saxofonista-bodas.php
Redirect 301 /videos/index.php https://www.saxonara.com/es/videos.php

# ==========================================================
# GENERAR SITEMAP QUAN ES DEMANA
# ==========================================================
RewriteEngine On
RewriteRule ^sitemap\.xml$ generar-sitemap.php [L]